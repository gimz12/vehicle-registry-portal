#!/bin/sh
# main is protected on GitHub (ruleset "protect-main"): pushes are rejected and
# changes must arrive via a pull request. Refuse the commit here so the work is
# not stranded on main and needing a rebase later.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "main" ]; then
  echo "Refusing to commit directly on main — it is protected."
  echo
  echo "  git switch -c my-change     # move to a branch, your staged files come along"
  echo "  git commit -m '...'"
  echo "  git push -u origin my-change"
  echo "  gh pr create --fill && gh pr merge --squash --delete-branch"
  echo
  echo "To override once: git commit --no-verify"
  exit 1
fi
